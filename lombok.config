config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true

# Newer Jackson (bundled with Spring Boot 3.5.x) no longer implicitly merges a
# field-level @JsonProperty rename with the Lombok-generated getter/setter for
# fields whose JavaBean accessor name doesn't case-fold back to the field name
# (e.g. "xRatio" -> "getXRatio()" -> implied property "XRatio"). Without this,
# the field-level rename and the getter/setter's implicit name are treated as
# two separate properties, so a global PropertyNamingStrategy (as applied by
# spring-boot-starter-data-rest) renames the accessor-derived property while
# leaving the @JsonProperty name untouched, producing duplicate JSON keys
# (e.g. both "xratio" and "xRatio"). Copying @JsonProperty onto the generated
# getter/setter keeps all accessors consistently annotated so Jackson merges
# them back into a single property.
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty
